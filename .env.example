EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: enables Google-powered address autocomplete in address fields.
# Falls back to OpenStreetMap/Nominatim (and then the device geocoder) if unset.
# Enable the "Geocoding API" for this key in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_maps_api_key

# Server-side only. Set this as a Supabase Edge Function secret, not in Expo:
# supabase secrets set GEMINI_API_KEY=your_gemini_api_key
# Optional:
# supabase secrets set GEMINI_MODEL=gemini-3.5-flash
